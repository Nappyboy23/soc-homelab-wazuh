# Copiez ce fichier en "deploy.env" (meme dossier) et remplissez VOS propres
# informations. deploy.env est ignore par git (.gitignore) : vos infos ne
# seront jamais commitees ni partagees.
#
#   cp config/deploy.env.example config/deploy.env

### Cible "manager" (Wazuh Manager + Indexer + Dashboard) ###
MANAGER_HOST="1.2.3.4"                       # IP publique (ou privee) de votre instance manager
MANAGER_SSH_USER="ubuntu"
MANAGER_SSH_KEY="$HOME/.ssh/ma-cle-manager.key"
MANAGER_SSH_PORT="22"

### Cible "agent" (endpoint surveille) ###
AGENT_HOST="5.6.7.8"
AGENT_SSH_USER="ubuntu"
AGENT_SSH_KEY="$HOME/.ssh/ma-cle-agent.key"
AGENT_SSH_PORT="22"
AGENT_NAME="endpoint-01"                     # nom affiche dans Wazuh

### Securite reseau ###
# CIDR autorise a atteindre SSH (22), le dashboard (443) et l'API (55000)
# sur le manager. Mettez VOTRE IP publique en /32. Ne mettez jamais 0.0.0.0/0.
ALLOWED_ADMIN_CIDR="203.0.113.10/32"

### Wazuh ###
WAZUH_VERSION="4.9"                          # branche majeure supportee par l'installeur officiel

### Pare-feu local (ufw/iptables sur les VM elles-memes) ###
# Complementaire du firewall cloud (OCI Security Lists, AWS Security Groups...)
# que vous devez configurer separement pour autoriser les memes ports depuis
# ALLOWED_ADMIN_CIDR.
CONFIGURE_FIREWALL="true"
